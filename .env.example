# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/aj_marketplace?schema=public"

# ── Auth (NextAuth) ───────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── Redis (cache / rate limiting / queues) ───────────────
REDIS_URL="redis://localhost:6379"

# ── Object storage (S3-compatible) ───────────────────────
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="aj-marketplace-media"
STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL="https://media.ajmarketplace.example"

# ── Payments ──────────────────────────────────────────────
# Never expose these to the client. Only read server-side.
PAYMENT_GATEWAY_PROVIDER="stripe"   # or "sslcommerz", "bkash", etc.
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# ── Email (notifications) ────────────────────────────────
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="AJ Marketplace <no-reply@ajmarketplace.example>"

# ── Admin bootstrap (used ONLY by prisma/seed.ts, one-time) ─
# Do not commit real values. Set these in your deploy environment's
# secret manager and run `npm run prisma:seed` once.
ADMIN_BOOTSTRAP_USERNAME="jawadabdullah"
ADMIN_BOOTSTRAP_PASSWORD="change-me-before-seeding"
ADMIN_BOOTSTRAP_EMAIL="admin@ajmarketplace.example"

# ── Commission default (overridable per-category / per-seller in DB) ─
DEFAULT_COMMISSION_PERCENTAGE="10"

# ── Checkout (Phase 3) ────────────────────────────────────
# Flat delivery fee (in the storefront's currency's smallest display unit,
# e.g. 60 = ৳60). Per-store/distance-based fees are a documented future
# extension, not required for MVP.
DELIVERY_FEE="60"

# Set to "true" only in local dev to seed demo categories/brand/store/
# products via `npm run prisma:seed` — never set this in staging/production.
SEED_DEMO_CATALOG="false"
